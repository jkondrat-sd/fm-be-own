        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test('Success with logged out message', () => {",
              "    pm.expect(body.success).to.eql(true);",
              "    pm.expect(body.data.message).to.include('Logged out');",
              "});",
              "",
              "pm.environment.unset('logout_test_refresh_token');",
              "pm.environment.unset('logout_test_access_token');"
            ]
          }
        }
