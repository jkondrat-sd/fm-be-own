      "name": "HAPPY: Logout (valid)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Login fresh to get a disposable refresh token for logout test",
              "pm.sendRequest({",
              "    url: pm.environment.get('base_url') + '/v1/auth/login',",
              "    method: 'POST',",
              "    header: { 'Content-Type': 'application/json' },",
              "    body: {",
              "        mode: 'raw',",
              "        raw: JSON.stringify({",
              "            email: pm.environment.get('admin_email'),",
              "            password: pm.environment.get('admin_password')",
              "        })",
              "    }",
              "}, function(err, res) {",
              "    const resBody = res.json();",
              "    if (resBody.success && resBody.data) {",
              "        pm.environment.set('logout_test_refresh_token', resBody.data.refreshToken);",
              "        pm.environment.set('logout_test_access_token', resBody.data.accessToken);",
              "    }",
              "});"
