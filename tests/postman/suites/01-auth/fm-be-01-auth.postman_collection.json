    {
      "name": "EDGE: OTP Rate Limit (6th request \u2192 429)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Send 5 OTP requests to fill the rate limit bucket",
              "const baseUrl = pm.environment.get('base_url');",
              "const phone = '+912222222222';",
              "let completed = 0;",
              "",
              "function sendOtp(callback) {",
              "    pm.sendRequest({",
              "        url: baseUrl + '/v1/auth/otp/request',",
              "        method: 'POST',",
              "        header: { 'Content-Type': 'application/json' },",
              "        body: {",
              "            mode: 'raw',",
              "            raw: JSON.stringify({ phone: phone })",
              "        }",
              "    }, function(err, res) {",
              "        completed++;",
              "        if (completed < 5) {",
              "            sendOtp(callback);",
              "        } else {",
              "            callback();",
              "        }",
              "    });",
              "}",
              "",
              "sendOtp(function() {",
              "    console.log('Sent 5 OTP requests to fill rate limit');",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 429 (rate limited)', () => pm.response.to.have.status(429));",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test('Error: RATE_LIMITED', () => {",
              "    pm.expect(body.success).to.eql(false);",
              "    pm.expect(body.error.code).to.eql('RATE_LIMITED');",
              "});",
              "",
              "pm.test('Has retryAfterSeconds in details', () => {",
              "    pm.expect(body.error.details).to.have.property('retryAfterSeconds');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"+912222222222\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/auth/otp/request",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "auth",
            "otp",
            "request"
          ]
        }
      }
    }
