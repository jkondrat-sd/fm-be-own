    {
      "name": "EDGE: Login \u2014 inactive user",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Create a temp user with unique email, then deactivate them",
              "const baseUrl = pm.environment.get('base_url');",
              "const adminToken = pm.environment.get('admin_access_token');",
              "const orgId = pm.environment.get('organization_id');",
              "const inactiveEmail = 'inactive-' + Date.now() + '@test.com';",
              "pm.environment.set('inactive_test_email', inactiveEmail);",
              "",
              "pm.sendRequest({",
              "    url: baseUrl + '/v1/admin/users',",
              "    method: 'POST',",
              "    header: {",
              "        'Authorization': 'Bearer ' + adminToken,",
              "        'Content-Type': 'application/json'",
              "    },",
              "    body: {",
              "        mode: 'raw',",
              "        raw: JSON.stringify({",
              "            email: inactiveEmail,",
              "            password: 'Inactive@123456',",
              "            role: 'ADMIN',",
              "            organizationId: orgId",
              "        })",
              "    }",
              "}, function(err, createRes) {",
              "    const createBody = createRes.json();",
              "    if (createBody.success && createBody.data) {",
              "        const userId = createBody.data.id;",
              "        pm.environment.set('inactive_test_user_id', userId);",
              "",
              "        // Deactivate the user",
              "        pm.sendRequest({",
              "            url: baseUrl + '/v1/admin/users/' + userId,",
              "            method: 'PUT',",
              "            header: {",
              "                'Authorization': 'Bearer ' + adminToken,",
              "                'Content-Type': 'application/json'",
              "            },",
              "            body: {",
              "                mode: 'raw',",
              "                raw: JSON.stringify({ isActive: false })",
              "            }",
              "        }, function(err2, updateRes) {",
              "            console.log('Temp user created and deactivated: ' + userId);",
              "        });",
              "    }",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 401 or 403 for inactive user', () => {",
              "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
              "});",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test('Error indicates deactivation', () => {",
              "    pm.expect(body.success).to.eql(false);",
              "    pm.expect(body.error).to.have.property('code');",
              "});",
              "",
              "// Cleanup: delete the temp user",
              "const baseUrl = pm.environment.get('base_url');",
              "const adminToken = pm.environment.get('admin_access_token');",
              "const tempId = pm.environment.get('inactive_test_user_id');",
              "if (tempId) {",
              "    pm.sendRequest({",
              "        url: baseUrl + '/v1/admin/users/' + tempId,",
              "        method: 'DELETE',",
              "        header: { 'Authorization': 'Bearer ' + adminToken }",
              "    }, function() {",
              "        pm.environment.unset('inactive_test_user_id');",
              "    });",
              "}"
            ]
          }
        }
      ],
