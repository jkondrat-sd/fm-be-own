    {
      "name": "HAPPY: OTP Verify (valid)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Request a fresh OTP so it's in Redis",
              "pm.sendRequest({",
              "    url: pm.environment.get('base_url') + '/v1/auth/otp/request',",
              "    method: 'POST',",
              "    header: { 'Content-Type': 'application/json' },",
              "    body: {",
              "        mode: 'raw',",
              "        raw: JSON.stringify({ phone: pm.environment.get('employee_phone') })",
              "    }",
              "}, function(err, res) {",
              "    // OTP is now in Redis; test runner must set otp_code env var",
              "    // via: redis-cli GET otp:<phone> or from server logs",
              "    console.log('OTP requested. Set otp_code env var from Redis/logs.');",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const otpCode = pm.environment.get('otp_code');",
              "",
              "if (!otpCode) {",
              "    pm.test('SKIP: otp_code not set \u2014 set from Redis (otp:<phone>) or server logs', () => {",
              "        console.warn('OTP verify test skipped: otp_code env var not set.');",
              "    });",
              "} else {",
              "    pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "    const body = pm.response.json();",
              "    const resData = body.data;",
              "",
              "    pm.test('Success envelope', () => {",
              "        pm.expect(body.success).to.eql(true);",
              "    });",
              "",
              "    pm.test('Has tokens and user info', () => {",
              "        pm.expect(resData).to.have.property('accessToken');",
              "        pm.expect(resData).to.have.property('refreshToken');",
              "        pm.expect(resData).to.have.property('userId');",
              "        pm.expect(resData).to.have.property('role');",
              "        pm.expect(resData.role).to.eql('EMPLOYEE');",
              "    });",
              "",
              "    // Store employee tokens for RBAC tests",
              "    if (resData && resData.accessToken) {",
              "        pm.environment.set('employee_access_token', resData.accessToken);",
              "        pm.environment.set('employee_refresh_token', resData.refreshToken);",
              "    }",
              "}"
            ]
          }
        }
      ],
