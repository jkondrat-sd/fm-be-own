      "name": "EDGE: Delete self (temp admin)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Create a temp admin with unique email, login as them, then attempt self-delete",
              "const baseUrl = pm.environment.get('base_url');",
              "const adminToken = pm.environment.get('admin_access_token');",
              "const orgId = pm.environment.get('organization_id');",
              "const selfDeleteEmail = 'self-delete-' + Date.now() + '@test.com';",
              "",
              "pm.sendRequest({",
              "    url: baseUrl + '/v1/admin/users',",
              "    method: 'POST',",
              "    header: {",
              "        'Authorization': 'Bearer ' + adminToken,",
              "        'Content-Type': 'application/json'",
              "    },",
              "    body: {",
              "        mode: 'raw',",
              "        raw: JSON.stringify({",
              "            email: selfDeleteEmail,",
              "            password: 'SelfDelete@123',",
              "            role: 'ADMIN',",
              "            organizationId: orgId",
              "        })",
              "    }",
              "}, function(err, createRes) {",
              "    const createBody = createRes.json();",
              "",
              "    if (createBody.success && createBody.data) {",
              "        const userId = createBody.data.id;",
              "        pm.environment.set('self_delete_user_id', userId);",
              "",
              "        // Login as the temp admin",
              "        pm.sendRequest({",
              "            url: baseUrl + '/v1/auth/login',",
              "            method: 'POST',",
              "            header: { 'Content-Type': 'application/json' },",
              "            body: {",
              "                mode: 'raw',",
              "                raw: JSON.stringify({",
              "                    email: selfDeleteEmail,",
              "                    password: 'SelfDelete@123'",
              "                })",
              "            }",
              "        }, function(err2, loginRes) {",
              "            const loginBody = loginRes.json();",
              "            if (loginBody.success && loginBody.data) {",
              "                pm.environment.set('self_delete_token', loginBody.data.accessToken);",
              "                pm.request.headers.upsert({",
              "                    key: 'Authorization',",
              "                    value: 'Bearer ' + loginBody.data.accessToken",
              "                });",
              "            }",
              "        });",
              "    }",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Self-delete returns 204 (API allows it)",
              "pm.test('Status 204 or 400/422 (self-delete behavior)', () => {",
              "    pm.expect(pm.response.code).to.be.oneOf([204, 400, 422]);",
              "});",
              "",
              "pm.environment.unset('self_delete_user_id');",
              "pm.environment.unset('self_delete_token');",
              "pm.environment.unset('self_delete_user_exists');"
            ]
          }
        }
      ],
