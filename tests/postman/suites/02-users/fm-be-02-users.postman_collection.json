  "item": [
    {
      "name": "HAPPY: Create user with phone (EMPLOYEE)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Generate a unique phone to avoid conflicts from previous runs (soft-delete keeps unique constraint)",
              "const suffix = String(Date.now()).slice(-9);",
              "const phone = '+919' + suffix;",
              "pm.environment.set('test_employee_phone', phone);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
              "",
              "const body = pm.response.json();",
              "const resData = body.data;",
              "",
              "pm.test('Success envelope', () => {",
              "    pm.expect(body.success).to.eql(true);",
              "});",
              "",
              "pm.test('User has expected fields', () => {",
              "    pm.expect(resData).to.have.property('id');",
              "    pm.expect(resData.phone).to.eql(pm.environment.get('test_employee_phone'));",
              "    pm.expect(resData.role).to.eql('EMPLOYEE');",
              "    pm.expect(resData.active).to.eql(true);",
              "    pm.expect(resData).to.have.property('organizationId');",
              "    pm.expect(resData).to.have.property('createdAt');",
              "    pm.expect(resData).to.have.property('updatedAt');",
              "});",
              "",
              "// Store for later suites",
              "if (resData) {",
              "    pm.environment.set('employee_user_id', resData.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{test_employee_phone}}\",\n  \"role\": \"EMPLOYEE\",\n  \"organizationId\": \"{{organization_id}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/admin/users",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "admin",
            "users"
          ]
        }
      }
    },
    {
      "name": "HAPPY: Create user with email+password (ADMIN)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Generate a unique email to avoid conflicts from previous runs",
              "const ts = Date.now();",
              "const email = 'testadmin-' + ts + '@test.com';",
              "pm.environment.set('test_admin_email', email);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
              "",
              "const body = pm.response.json();",
              "const resData = body.data;",
              "",
              "pm.test('User has expected fields', () => {",
              "    pm.expect(resData.email).to.eql(pm.environment.get('test_admin_email'));",
              "    pm.expect(resData.role).to.eql('ADMIN');",
              "    pm.expect(resData.active).to.eql(true);",
              "    pm.expect(resData.phone).to.be.null;",
              "});",
              "",
              "// Store temp user ID for update/delete tests",
              "if (resData) {",
              "    pm.environment.set('test_user_id', resData.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_admin_email}}\",\n  \"password\": \"TestAdmin@123456\",\n  \"role\": \"ADMIN\",\n  \"organizationId\": \"{{organization_id}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/admin/users",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "admin",
            "users"
          ]
        }
      }
    },
