    {
      "name": "HAPPY: List users (default pagination)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v1/admin/users",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "admin",
            "users"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test('Success with data array', () => {",
              "    pm.expect(body.success).to.eql(true);",
              "    pm.expect(body.data).to.be.an('array');",
              "    pm.expect(body.data.length).to.be.above(0);",
              "});",
              "",
              "pm.test('Has pagination meta', () => {",
              "    pm.expect(body.meta).to.have.property('page');",
              "    pm.expect(body.meta).to.have.property('limit');",
              "    pm.expect(body.meta).to.have.property('total');",
              "    pm.expect(body.meta).to.have.property('totalPages');",
              "    pm.expect(body.meta.page).to.eql(1);",
              "    pm.expect(body.meta.limit).to.eql(20);",
              "});",
              "",
              "pm.test('User objects have required fields', () => {",
              "    const user = body.data[0];",
              "    pm.expect(user).to.have.property('id');",
              "    pm.expect(user).to.have.property('role');",
              "    pm.expect(user).to.have.property('organizationId');",
              "    pm.expect(user).to.have.property('createdAt');",
              "    pm.expect(user).to.have.property('active');",
              "});"
            ]
          }
        }
      ]
    },
