{
  "info": {
    "name": "FM-BE - 00-Smoke",
    "_postman_id": "e9d1f5c7ecac6df5",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v1/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "const body = pm.response.json();",
              "const resData = body.data || body;",
              "",
              "pm.test('Status is UP', () => {",
              "    pm.expect(resData.status).to.eql('UP');",
              "});",
              "",
              "pm.test('Database service present', () => {",
              "    pm.expect(resData.services).to.have.property('database');",
              "});",
              "",
              "pm.test('Redis service present', () => {",
              "    pm.expect(resData.services).to.have.property('redis');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "OpenAPI Docs Available",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v3/api-docs",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v3",
            "api-docs"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Has OpenAPI info', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('openapi');",
              "    pm.expect(body).to.have.property('paths');",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global pre-request: set common headers",
          "if (pm.environment.get('access_token')) {",
          "    pm.request.headers.upsert({",
          "        key: 'Authorization',",
          "        value: 'Bearer ' + pm.environment.get('access_token')",
          "    });",
          "}",
          "pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test: response time check",
          "pm.test('Response time < 5s', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});"
        ]
      }
    }
  ]
}