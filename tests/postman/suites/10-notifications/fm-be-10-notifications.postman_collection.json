{
  "info": {
    "name": "FM-BE - 10-Notifications",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "HAPPY: Send notification",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/v1/notifications/send",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "notifications",
            "send"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{admin_user_id}}\",\n  \"title\": \"Test Title\",\n  \"body\": \"Hello body message\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + pm.environment.get('admin_access_token') });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "var body = pm.response.json();",
              "var resData = body.data;",
              "pm.test('Has ID', function () { pm.expect(resData.id).to.be.a('string'); });",
              "pm.test('Has unread=true', function () { pm.expect(resData.read).to.eql(false); });",
              "pm.environment.set('notification_id', resData.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "HAPPY: Send with metadata",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/v1/notifications/send",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "notifications",
            "send"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{admin_user_id}}\",\n  \"title\": \"Alert Title\",\n  \"body\": \"Alert body\",\n  \"type\": \"ALERT\",\n  \"metadata\": {\n    \"key\": \"value\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + pm.environment.get('admin_access_token') });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "var body = pm.response.json();",
              "var resData = body.data;",
              "pm.test('Metadata present', function () { pm.expect(resData.metadata).to.be.an('object'); pm.expect(resData.metadata.key).to.eql('value'); });",
              "pm.test('Type matches', function () { pm.expect(resData.type).to.eql('ALERT'); });",
              "pm.environment.set('notification_id_2', resData.id);"
            ]
          }
        }
      ]
    },
