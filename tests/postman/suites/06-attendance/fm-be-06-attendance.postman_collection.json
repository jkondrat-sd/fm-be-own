  "item": [
    {
      "name": "HAPPY: Punch IN inside geofence",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v1/attendance/punch",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "attendance",
            "punch"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"punchType\": \"IN\",\n  \"latitude\": 19.076,\n  \"longitude\": 72.8777,\n  \"accuracy\": 10.0,\n  \"faceMatchScore\": 0.92,\n  \"deviceInfo\": {\n    \"model\": \"Pixel 7\",\n    \"os\": \"Android 14\",\n    \"appVersion\": \"1.0.0\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var adminToken = pm.environment.get('admin_access_token');",
              "var orgId = pm.environment.get('organization_id');",
              "var siteId = pm.environment.get('site_id');",
              "var baseUrl = pm.environment.get('base_url');",
              "",
              "// Generate unique employee per test run (avoids 5-min dedup conflicts on re-run)",
              "var ts = Date.now().toString();",
              "var email = 'att-' + ts + '@fmtest.com';",
              "var phone = '+9199' + ts.slice(-8);",
              "pm.environment.set('_att_emp_email', email);",
              "",
              "pm.sendRequest({",
              "    url: baseUrl + '/v1/employees',",
              "    method: 'POST',",
              "    header: [{ key: 'Content-Type', value: 'application/json' }, { key: 'Authorization', value: 'Bearer ' + adminToken }],",
              "    body: { mode: 'raw', raw: JSON.stringify({ fullName: 'Att Employee ' + ts.slice(-4), phone: phone, email: email, organizationId: orgId, siteId: siteId }) }",
              "}, function(err, res) {",
              "    if (res.code !== 201) { console.log('Employee create failed:', res.code, res.json()); return; }",
              "    var empData = res.json().data;",
              "    pm.environment.set('attendance_employee_id', empData.id);",
              "    var userId = empData.userId;",
              "",
              "    pm.sendRequest({",
              "        url: baseUrl + '/v1/admin/users/' + userId,",
              "        method: 'PUT',",
              "        header: [{ key: 'Content-Type', value: 'application/json' }, { key: 'Authorization', value: 'Bearer ' + adminToken }],",
              "        body: { mode: 'raw', raw: JSON.stringify({ password: 'Test@123456' }) }",
              "    }, function(e2, r2) {",
              "        pm.sendRequest({",
              "            url: baseUrl + '/v1/auth/login',",
              "            method: 'POST',",
              "            header: [{ key: 'Content-Type', value: 'application/json' }],",
              "            body: { mode: 'raw', raw: JSON.stringify({ email: email, password: 'Test@123456' }) }",
              "        }, function(e3, r3) {",
              "            if (r3.code === 200) {",
              "                var ld = r3.json().data;",
              "                pm.environment.set('employee_access_token', ld.accessToken);",
              "                pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + ld.accessToken });",
              "            }",
              "        });",
              "    });",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "var resData = pm.response.json();",
              "var punch = resData.data;",
              "pm.test('Has punch ID', function () { pm.expect(punch.id).to.be.a('string'); });",
              "pm.test('PunchType is IN', function () { pm.expect(punch.punchType).to.eql('IN'); });",
              "pm.test('Inside geofence', function () { pm.expect(punch.insideGeofence).to.be.true; });",
              "pm.test('Has employeeId', function () { pm.expect(punch.employeeId).to.be.a('string'); });",
              "pm.test('Has siteId', function () { pm.expect(punch.siteId).to.be.a('string'); });",
              "pm.test('FaceMatchScore preserved', function () { pm.expect(punch.faceMatchScore).to.eql(0.92); });",
              "pm.test('Has punchTime', function () { pm.expect(punch.punchTime).to.be.a('string'); });",
              "pm.environment.set('attendance_log_id', punch.id);",
              "pm.environment.set('attendance_employee_id', punch.employeeId);"
            ]
          }
        }
      ]
    },
