    {
      "name": "EDGE: Punch at inactive site",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v1/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var adminToken = pm.environment.get('admin_access_token');",
              "var empToken = pm.environment.get('employee_access_token');",
              "var siteId = pm.environment.get('site_id');",
              "var baseUrl = pm.environment.get('base_url');",
              "",
              "// Step 1: Deactivate site",
              "pm.sendRequest({",
              "    url: baseUrl + '/v1/sites/' + siteId,",
              "    method: 'PUT',",
              "    header: [{ key: 'Content-Type', value: 'application/json' }, { key: 'Authorization', value: 'Bearer ' + adminToken }],",
              "    body: { mode: 'raw', raw: JSON.stringify({ isActive: false }) }",
              "}, function(err, deactRes) {",
              "    // Step 2: Attempt punch at the now-inactive site",
              "    pm.sendRequest({",
              "        url: baseUrl + '/v1/attendance/punch',",
              "        method: 'POST',",
              "        header: [{ key: 'Content-Type', value: 'application/json' }, { key: 'Authorization', value: 'Bearer ' + empToken }],",
              "        body: { mode: 'raw', raw: JSON.stringify({ punchType: 'IN', latitude: 19.076, longitude: 72.8777 }) }",
              "    }, function(err2, punchRes) {",
              "        pm.environment.set('_inactive_site_status', punchRes.code.toString());",
              "        pm.environment.set('_inactive_site_body', JSON.stringify(punchRes.json()));",
              "",
              "        // Step 3: Reactivate site immediately",
              "        pm.sendRequest({",
              "            url: baseUrl + '/v1/sites/' + siteId,",
              "            method: 'PUT',",
              "            header: [{ key: 'Content-Type', value: 'application/json' }, { key: 'Authorization', value: 'Bearer ' + adminToken }],",
              "            body: { mode: 'raw', raw: JSON.stringify({ isActive: true }) }",
              "        }, function(err3, reactRes) { /* site reactivated */ });",
              "    });",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var status = parseInt(pm.environment.get('_inactive_site_status'));",
              "var body = JSON.parse(pm.environment.get('_inactive_site_body'));",
              "",
              "pm.test('Status 410 (SITE_INACTIVE)', function () { pm.expect(status).to.eql(410); });",
              "pm.test('Error code SITE_INACTIVE', function () { pm.expect(body.error.code).to.eql('SITE_INACTIVE'); });",
              "pm.test('Success false', function () { pm.expect(body.success).to.be.false; });"
            ]
          }
        }
      ]
    },
