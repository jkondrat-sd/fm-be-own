{
  "info": {
    "name": "FM-BE - 08-SiteUpdates",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "HAPPY: Create text-only update",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"siteId\": \"{{site_id}}\",\n  \"text\": \"All clear at Mumbai HQ\",\n  \"recordedAt\": \"{{$isoTimestamp}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/site-updates",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "site-updates"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + pm.environment.get('employee_access_token') });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "var body = pm.response.json();",
              "var resData = body.data;",
              "pm.test('Has ID', function () { pm.expect(resData.id).to.be.a('string'); });",
              "pm.test('Text matches', function () { pm.expect(resData.text).to.eql('All clear at Mumbai HQ'); });",
              "pm.environment.set('site_update_id', resData.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "HAPPY: Create with text + media",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
