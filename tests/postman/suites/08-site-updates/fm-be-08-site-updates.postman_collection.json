          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"siteId\": \"{{site_id}}\",\n  \"text\": \"Material delivery progress\",\n  \"mediaUrls\": [\n    \"https://s3.example.com/fm/photos/1.jpg\",\n    \"https://s3.example.com/fm/photos/2.jpg\"\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/site-updates",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
