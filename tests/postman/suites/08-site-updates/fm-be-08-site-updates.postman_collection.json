    {
      "name": "HAPPY: List updates for site",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v1/site-updates/site/{{site_id}}?page=1&limit=10",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "site-updates",
            "site",
            "{{site_id}}"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + pm.environment.get('admin_access_token') });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var body = pm.response.json();",
              "var resData = body.data;",
              "pm.test('Data is array', function () { pm.expect(resData).to.be.an('array'); });",
              "pm.test('Has meta', function () { pm.expect(body.meta).to.exist; });",
              "pm.test('Found recent updates', function () { pm.expect(resData.length).to.be.at.least(2); });"
            ]
          }
        }
      ]
    },
