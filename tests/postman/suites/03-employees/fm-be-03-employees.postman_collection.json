    {
      "name": "HAPPY: Employee gets own profile (/me)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const empToken = pm.environment.get('employee_access_token');",
              "if (empToken) {",
              "    pm.request.headers.upsert({",
              "        key: 'Authorization',",
              "        value: 'Bearer ' + empToken",
              "    });",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const empToken = pm.environment.get('employee_access_token');",
              "",
              "if (!empToken) {",
              "    pm.test('SKIP: employee_access_token not set (requires OTP automation)', () => {",
              "        console.warn('Employee /me test skipped: employee_access_token not available.');",
              "    });",
              "} else {",
              "    pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
