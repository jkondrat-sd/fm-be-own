    {
      "name": "HAPPY: List employees paginated",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v1/employees?page=1&limit=10",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "employees"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test('Success with data array', () => {",
              "    pm.expect(body.success).to.eql(true);",
              "    pm.expect(body.data).to.be.an('array');",
              "    pm.expect(body.data.length).to.be.above(0);",
              "});",
              "",
              "pm.test('Has pagination meta', () => {",
              "    pm.expect(body.meta).to.have.property('page');",
              "    pm.expect(body.meta).to.have.property('limit');",
              "    pm.expect(body.meta).to.have.property('total');",
              "    pm.expect(body.meta).to.have.property('totalPages');",
              "    pm.expect(body.meta.page).to.eql(1);",
              "    pm.expect(body.meta.limit).to.eql(10);",
              "});",
              "",
              "pm.test('Employee objects have required fields', () => {",
              "    const emp = body.data[0];",
              "    pm.expect(emp).to.have.property('id');",
              "    pm.expect(emp).to.have.property('userId');",
              "    pm.expect(emp).to.have.property('fullName');",
              "    pm.expect(emp).to.have.property('role');",
              "    pm.expect(emp).to.have.property('organizationId');",
              "});"
            ]
          }
        }
      ]
    },
