  "item": [
    {
      "name": "HAPPY: Create employee with all fields",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const ts = Date.now();",
              "const phone = '+918' + String(ts).slice(-9);",
              "const email = 'emp-' + ts + '@test.com';",
              "pm.environment.set('test_emp_phone', phone);",
              "pm.environment.set('test_emp_email', email);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
              "",
              "const body = pm.response.json();",
              "const resData = body.data;",
              "",
              "pm.test('Success envelope with traceId', () => {",
              "    pm.expect(body.success).to.eql(true);",
              "    pm.expect(body).to.have.property('traceId');",
              "});",
              "",
              "pm.test('Employee has expected fields', () => {",
              "    pm.expect(resData).to.have.property('id');",
              "    pm.expect(resData).to.have.property('userId');",
              "    pm.expect(resData.fullName).to.eql('Integration Test Employee');",
              "    pm.expect(resData.phone).to.eql(pm.environment.get('test_emp_phone'));",
              "    pm.expect(resData.email).to.eql(pm.environment.get('test_emp_email'));",
              "    pm.expect(resData.role).to.eql('EMPLOYEE');",
              "    pm.expect(resData.organizationId).to.eql(pm.environment.get('organization_id'));",
              "    pm.expect(resData.hasFaceRegistered).to.eql(false);",
              "    pm.expect(resData.documents).to.be.an('array').that.is.empty;",
              "    pm.expect(resData).to.have.property('createdAt');",
              "    pm.expect(resData).to.have.property('updatedAt');",
              "});",
              "",
              "if (resData) {",
              "    pm.environment.set('employee_id', resData.id);",
              "    pm.environment.set('employee_user_id_for_emp', resData.userId);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Integration Test Employee\",\n  \"phone\": \"{{test_emp_phone}}\",\n  \"email\": \"{{test_emp_email}}\",\n  \"dob\": \"1995-06-15\",\n  \"organizationId\": \"{{organization_id}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/employees",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "employees"
          ]
        }
      }
    },
