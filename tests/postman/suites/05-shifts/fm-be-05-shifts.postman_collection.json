  "item": [
    {
      "name": "6.1 HAPPY: Create day shift",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/v1/shifts",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "shifts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"siteId\": \"{{site_id}}\",\n  \"name\": \"Day Shift\",\n  \"startTime\": \"09:00:00\",\n  \"endTime\": \"18:00:00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + pm.environment.get('admin_access_token') });",
              "console.log('Using site_id: ' + pm.environment.get('site_id'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "    const resData = pm.response.json();",
              "    const shift = resData.data;",
              "    pm.test('Has ID', function () { pm.expect(shift.id).to.be.a('string'); });",
              "    pm.test('Name matches', function () { pm.expect(shift.name).to.eql('Day Shift'); });",
              "    pm.environment.set('shift_id', shift.id);",
              "} else {",
              "    console.error('Create shift failed with status ' + pm.response.code + ': ' + pm.response.text());",
              "}"
            ]
          }
        }
      ]
    },
