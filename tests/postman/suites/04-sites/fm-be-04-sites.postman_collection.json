        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Unauthorized Site\",\n  \"organizationId\": \"{{organization_id}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const empToken = pm.environment.get('employee_access_token');",
              "if (empToken) {",
              "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + empToken });",
              "} else {",
              "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer invalid-token-for-rbac' });",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 403 or 401', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
              "});"
            ]
          }
        }
      ]
