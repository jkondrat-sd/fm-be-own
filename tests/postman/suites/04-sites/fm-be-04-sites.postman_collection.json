        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const resData = pm.response.json();",
              "pm.test('Success true', function () { pm.expect(resData.success).to.be.true; });",
              "pm.test('Data is array', function () { pm.expect(resData.data).to.be.an('array'); });",
              "pm.test('Has meta pagination', function () {",
              "    pm.expect(resData.meta).to.have.property('page');",
              "    pm.expect(resData.meta).to.have.property('limit');",
              "    pm.expect(resData.meta).to.have.property('total');",
              "    pm.expect(resData.meta).to.have.property('totalPages');",
              "});",
              "pm.test('At least 2 sites exist', function () { pm.expect(resData.data.length).to.be.at.least(2); });"
            ]
          }
        }
