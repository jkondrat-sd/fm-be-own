  "item": [
    {
      "name": "Create site with location",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v1/sites",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "sites"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Mumbai HQ\",\n  \"address\": \"123 Marine Drive, Mumbai\",\n  \"latitude\": 19.076,\n  \"longitude\": 72.8777,\n  \"geofenceRadius\": 500,\n  \"organizationId\": \"{{organization_id}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + pm.environment.get('admin_access_token') });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "const resData = pm.response.json();",
              "const site = resData.data;",
              "pm.test('Has site ID', function () { pm.expect(site.id).to.be.a('string'); });",
              "pm.test('Name matches', function () { pm.expect(site.name).to.eql('Mumbai HQ'); });",
              "pm.test('Latitude set', function () { pm.expect(site.latitude).to.eql(19.076); });",
              "pm.test('Longitude set', function () { pm.expect(site.longitude).to.eql(72.8777); });",
              "pm.test('GeofenceRadius set', function () { pm.expect(site.geofenceRadius).to.eql(500); });",
              "pm.test('Active by default', function () { pm.expect(site.active).to.be.true; });",
              "pm.test('OrganizationId set', function () { pm.expect(site.organizationId).to.be.a('string'); });",
              "pm.test('Has timestamps', function () { pm.expect(site.createdAt).to.be.a('string'); pm.expect(site.updatedAt).to.be.a('string'); });",
              "pm.environment.set('site_id', site.id);"
            ]
          }
        }
      ]
    },
