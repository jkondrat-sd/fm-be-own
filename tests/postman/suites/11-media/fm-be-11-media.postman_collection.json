{
  "info": {
    "name": "11. Media Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "11.01 HAPPY: Presigned URL - Image",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fileName\": \"test.jpg\",\n  \"contentType\": \"image/jpeg\",\n  \"fileSize\": 4194304,\n  \"category\": \"uploads\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/media/presigned-url",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "media",
            "presigned-url"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + pm.environment.get('admin_access_token') });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "var resData = pm.response.json().data;",
              "pm.test('Has uploadUrl', function() { pm.expect(resData.uploadUrl).to.not.be.empty; });",
              "pm.test('Has fileKey', function() { pm.expect(resData.fileKey).to.not.be.empty; });",
              "pm.environment.set('presigned_upload_url', resData.uploadUrl);",
              "pm.environment.set('media_file_key', resData.fileKey);"
            ]
          }
        }
      ]
    },
