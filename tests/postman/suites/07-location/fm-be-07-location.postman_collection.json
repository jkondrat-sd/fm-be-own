      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + pm.environment.get('admin_access_token') });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var resData = pm.response.json();",
              "var locations = resData.data;",
              "pm.test('Data is array', function () { pm.expect(locations).to.be.an('array'); });",
              "if (locations.length > 0) {",
              "    pm.test('Location has expected fields', function () {",
              "        var loc = locations[0];",
              "        pm.expect(loc.employeeId).to.be.a('string');",
              "        pm.expect(loc.latitude).to.be.a('number');",
              "        pm.expect(loc.longitude).to.be.a('number');",
              "        pm.expect(loc.lastUpdated).to.be.a('string');",
              "    });",
              "}"
            ]
          }
        }
      ]
    },
