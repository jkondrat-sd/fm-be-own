  "item": [
    {
      "name": "HAPPY: Update location (all fields)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v1/location/update",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "location",
            "update"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"latitude\": 19.076,\n  \"longitude\": 72.8777,\n  \"accuracy\": 10.0,\n  \"battery\": 0.85,\n  \"signal\": 4.0,\n  \"airplaneMode\": false\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + pm.environment.get('employee_access_token') });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var resData = pm.response.json();",
              "pm.test('Response has status ok', function () { pm.expect(resData.data.status).to.eql('ok'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "HAPPY: Live locations for site",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
